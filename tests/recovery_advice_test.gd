extends "res://tests/test_suite.gd"

func _run() -> void:
	for fps: int in [30,60,120]:
		var dt := 1.0/fps
		var advice := RallyRecoveryAdvice.new()
		for i: int in range(fps*6): advice.update(dt,0,1,1,0,0,true,0,Vector3.ZERO)
		check(not advice.visible,"%d Hz: intentional parking stays quiet"%fps)
		for i: int in range(fps*6): advice.update(dt,0,1,1,1,1,true,0,Vector3.ZERO)
		check(not advice.visible,"%d Hz: brake and throttle do not trigger"%fps)
		for i: int in range(fps*6): advice.update(dt,0,1,1,1,0,true,1,Vector3.ZERO)
		check(not advice.visible,"%d Hz: handbrake start does not trigger"%fps)
		for i: int in range(fps*6): advice.update(dt,0,1,1,1,0,true,0,Vector3.ZERO,false)
		check(not advice.visible,"%d Hz: neutral revving does not trigger"%fps)
		for i: int in range(fps*3): advice.update(dt,0,1,1,1,0,true,0,Vector3.ZERO)
		check(not advice.visible,"%d Hz: short obstruction stays quiet"%fps)
		for i: int in range(fps*2): advice.update(dt,1.2,1,1,1,0,true,0,Vector3(sin(i*.5)*.25,.15,0))
		check(advice.visible and advice.reason=="车辆受困","%d Hz: rocking in place is detected despite velocity"%fps)
		for i: int in range(fps*3): advice.update(dt,0,1,1,0,0,true,0,Vector3.ZERO)
		check(advice.visible,"%d Hz: releasing throttle leaves time to read"%fps)
		advice.update(dt,2,1,1,1,0,true,0,Vector3(0,0,2))
		check(not advice.visible,"%d Hz: driving out, including reverse, clears hint"%fps)
		advice.reset()
		for i: int in range(fps*12): advice.update(dt,.5,1,1,1,0,true,0,Vector3(i*dt*.5,0,0))
		check(not advice.visible,"%d Hz: continuous slow progress is not stuck"%fps)
		advice.reset()
		for i: int in range(fps*3): advice.update(dt,.1,-1,1,0,0,true,0,Vector3.ZERO)
		check(advice.visible and advice.reason=="车辆翻覆","%d Hz: overturned car does not require throttle"%fps)
		advice.update(dt,0,1,1,0,0,true,0,Vector3.ZERO)
		check(not advice.visible,"%d Hz: self-righting clears overturned hint"%fps)
		for i: int in range(fps*5): advice.update(dt,0,1,1,1,0,true,0,Vector3.ZERO)
		advice.update(dt,0,1,1,1,0,false,0,Vector3.ZERO)
		check(not advice.visible and advice.blocked_time==0,"%d Hz: leaving manual driving clears all history"%fps)
	var legacy := RallyRecoveryAdvice.new()
	for i: int in range(510): legacy.update(1.0/120,0,1,1,1,0,true)
	check(legacy.visible and not legacy.update(.1,8,1,1,1,0,true),"Legacy callers without world positions still detect and clear blocked cars")
	for i: int in range(630): legacy.update(1.0/120,0,1,-1,0,0,true)
	check(legacy.visible,"Existing stationary wrong-way advice is retained")
	finish()
