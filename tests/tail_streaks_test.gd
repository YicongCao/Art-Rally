extends "res://tests/test_suite.gd"
func _run() -> void:
	var world := Node3D.new()
	root.add_child(world)
	var camera := Camera3D.new()
	world.add_child(camera)
	camera.position = Vector3(6,3,8)
	var trails := RallyTailStreaks.new()
	trails.build(world,Vector3(1.88,.5,4.2))
	trails.update(Transform3D(Basis.IDENTITY,Vector3.ZERO),0,.016,camera)
	check(trails.mesh.get_surface_count()==0,"Stationary car emits no aerodynamic streaks")
	for i: int in range(4): trails.update(Transform3D(Basis.IDENTITY,Vector3(0,1,-i*.4)),22,.016,camera)
	check(trails.mesh.get_surface_count()==1 and trails.mesh.get_aabb().size.x>1.5,"Both tail lights produce separate ribbons at driving speed")
	trails.update(Transform3D(Basis.IDENTITY,Vector3(2000,1,0)),22,.016,camera)
	check(trails.history.size()==1 and trails.mesh.get_surface_count()==0,"A recovery teleport never draws a streak across the map")
	for i: int in range(120): trails.update(Transform3D(Basis.IDENTITY,Vector3(2000,1,-i*.4)),22,.016,camera)
	check(trails.history.size()<=48,"Streak storage stays bounded during long driving")
	trails.update(Transform3D(Basis.IDENTITY,Vector3(2000,1,-48)),2,.016,camera)
	check(trails.history.is_empty() and trails.mesh.get_surface_count()==0,"Slow driving clears the residual fast trail")
	world.free()
	finish()
